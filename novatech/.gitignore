# ==========================================
# NovaTech - Git Ignore
# ==========================================

# Dependencies
/node_modules
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Testing
/coverage

# Next.js
/.next/
/out/
next-env.d.ts

# Production
/build
dist/

# Environment variables and secrets
.env
.env.*
!.env.example
!.env.local.example
*.pem
*.key

# Vercel
.vercel/

# TypeScript
*.tsbuildinfo

# Debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Operating system
.DS_Store
Thumbs.db
desktop.ini

# Editor files
.vscode/
.idea/
*.swp

# Local AI assistant configuration
.agents/
.claude/
.cursor/
.devin/

# Local backups
*.backup.txt
*.backup-settings.txt
page.backup*.txt

# Temporary files
*.tmp
*.temp